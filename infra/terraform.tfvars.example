# Copy to terraform.tfvars (gitignored) and set the real, machine-local value.
# Never commit terraform.tfvars.

kubeconfig_path = "/home/gtoth/.kube/homelab-k3s.yaml"

# k3s generates a single context named "default"; override only if your copy renames it.
# kube_context = "default"

# jwt_secret and the postgres_* values: this workspace uses Local execution
# mode, so HCP Terraform never evaluates workspace variables for it (see
# infra/README.md "Secrets"). Supply real values here (never commit them),
# or export the matching TF_VAR_* for a single session.
#
# postgres_user / postgres_db must be valid unquoted Postgres identifiers and
# postgres_password must be URL-safe ([A-Za-z0-9_-]) — a deliberate MVP
# simplification so the derived DATABASE_URL needs no escaping.

# jwt_secret        = "replace-with-a-strong-local-dev-secret"
# postgres_db       = "homestreamlab"
# postgres_user     = "homestreamlab_app"
# postgres_password = "replace-with-a-strong-url-safe-password"

# Full image references from the local registry, with an explicit non-latest
# tag, following the shared local-jenkins-platform OCI consumer contract
# (<registry>/<project>/<component>:<git-sha> — NOT a flat homestreamlab-backend
# style name). The Jenkinsfile injects these two via TF_VAR_backend_image /
# TF_VAR_frontend_image at plan time; you only need real values here for a
# manual local plan/apply.
# backend_image  = "192.168.1.100:5000/homestreamlab/backend:0000000"
# frontend_image = "192.168.1.100:5000/homestreamlab/frontend:0000000"

# Ingress hostname + Traefik HTTP entrypoint. Both have working defaults
# (homestreamlab.homelab.home.arpa / web) — uncomment only to override.
# The frontend image must be built with
# --build-arg VITE_API_URL=http://<ingress_host> (see infra/README.md "Ingress").
# ingress_host       = "homestreamlab.homelab.home.arpa"
# traefik_entrypoint = "web"
